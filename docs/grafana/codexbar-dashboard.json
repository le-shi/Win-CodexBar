        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "codexbar_quota_used_percent{job=~\"$job\",instance=~\"$instance\",provider=~\"$provider\",window=~\"$window\"}",
          "legendFormat": "{{provider}} / {{window}} used",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "codexbar_quota_remaining_percent{job=~\"$job\",instance=~\"$instance\",provider=~\"$provider\",window=~\"$window\"}",
          "hide": false,
          "legendFormat": "{{provider}} / {{window}} remaining",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Quota History",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Remaining time until each quota window resets. Missing reset timestamps are omitted by the exporter.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3600
              },
              {
                "color": "green",
                "value": 21600
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "id": 9,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "clamp_min(codexbar_quota_reset_timestamp_seconds{job=~\"$job\",instance=~\"$instance\",provider=~\"$provider\",window=~\"$window\"} - time(), 0)",
          "instant": true,
          "legendFormat": "{{provider}} / {{window}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Time Until Quota Reset",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Whether the latest provider usage collection succeeded.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
