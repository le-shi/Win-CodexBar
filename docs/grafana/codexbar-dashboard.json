      "id": 10,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "codexbar_provider_up{job=~\"$job\",instance=~\"$instance\",provider=~\"$provider\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "{{provider}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Provider Fetch Health",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "provider": 0,
              "Value": 1
            },
            "renameByName": {
              "Value": "Fetch up",
              "provider": "Provider"
            }
          }
        }
      ],
      "type": "table"
    },
