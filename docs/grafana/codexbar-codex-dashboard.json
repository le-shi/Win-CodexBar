            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * (sum(codexbar_provider_up{monitor=\"codexbar-codex\",job=~\"$job\",instance=~\"$instance\",provider=\"codex\"} * on(job, instance, provider) codexbar_provider_enabled{monitor=\"codexbar-codex\",job=~\"$job\",instance=~\"$instance\",provider=\"codex\"} * on(job, instance) group_left up{monitor=\"codexbar-codex\",job=~\"$job\",instance=~\"$instance\"} * on(job, instance) group_left codexbar_up{monitor=\"codexbar-codex\",job=~\"$job\",instance=~\"$instance\"}) or vector(0)) / clamp_min(count(up{monitor=\"codexbar-codex\",job=~\"$job\",instance=~\"$instance\"}), 1)",
          "instant": true,
          "legendFormat": "健康率",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Codex 健康节点比例",
      "type": "stat"
