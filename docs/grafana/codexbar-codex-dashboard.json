      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "codexbar_provider_data_age_seconds{job=~\"${job:regex}\",instance=~\"${instance:regex}\",provider=\"codex\"}",
          "legendFormat": "{{instance}} / {{provider}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Codex Data Age",
      "type": "timeseries"
