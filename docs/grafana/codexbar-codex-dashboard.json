      "targets": [
        {
          "editorMode": "code",
          "expr": "codexbar_quota_used_percent{job=~\"${job:regex}\",instance=~\"${instance:regex}\",provider=\"codex\",window=~\"${window:regex}\"}",
          "instant": true,
          "legendFormat": "{{instance}} / {{window}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Quota Used Now",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Codex quota utilization history. Use the instance and window variables to narrow the series.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
